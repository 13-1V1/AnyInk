{
	"name": "anyink",
	"author": "Matt LaGrandeur",
	"version": "2.10",
	"license": "GPL-3.0-or-later",
	"description": "ANY-INK: a personal, purely visual font editor. Fork of Glyphr Studio v2.",
	"type": "module",
	"scripts": {
		"dev": "run-func scripts.js dev && vite serve ./src/",
		"build": "vite build ./src/ --emptyOutDir",
		"stage": "run-func scripts.js stage  && vite build ./src/ --emptyOutDir --base=/staged/",
		"test": "vitest watch",
		"coverage": "vitest watch --silent=true --coverage",
		"lint": "eslint src",
		"fix": "eslint src --fix",
		"pages": "vite --config tests/vite.config.js",
		"preview": "vite preview ./src/ --base=/AnyInk/",
		"pwa:icons": "node src/anyink/pwa/generate-icons.js",
		"test:pwa": "vitest run tests/pwa.test.js",
		"verify:pwa": "npm run build && node tests/pwa.verify.mjs",
		"verify:pwa-storage": "node tests/pwa-storage.verify.mjs",
		"verify:menus": "node tests/menus.verify.mjs",
		"verify:leave": "node tests/leave-warning.verify.mjs",
		"verify:notices": "npm run build && node tests/notices.verify.mjs",
		"verify:b1": "node tests/b1.verify.mjs",
		"verify:guides": "node tests/guides.verify.mjs",
		"verify:fontcheck": "node tests/fontcheck.verify.mjs",
		"verify:check-line": "node tests/check-line.verify.mjs",
		"verify:undo": "node tests/undo.verify.mjs",
		"verify:spacing": "node tests/spacing.verify.mjs",
		"verify:placement": "node tests/placement.verify.mjs",
		"verify:b23": "node tests/b23.verify.mjs",
		"verify:hooks": "node tests/hooks.verify.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@playwright/test": "1.63.0",
		"@types/jest": "^29.5.12",
		"@vitest/browser": "^4.1.11",
		"buffer": "^6.0.3",
		"eslint-config-prettier": "^8.5.0",
		"eslint-plugin-prettier": "^4.2.1",
		"globals": "^17.6.0",
		"jsdom": "^24.0.0",
		"lit": "^3.1.4",
		"prettier": "^2.7.1",
		"run-func": "^3.0.0",
		"sharp": "0.35.4",
		"typescript-eslint": "^8.61.1",
		"vi-canvas-mock": "^1.0.0",
		"vite": ">=7.3.2",
		"vite-plugin-pwa": "1.3.0",
		"vitest": "^4.1.11",
		"workbox-precaching": "7.4.1",
		"workbox-routing": "7.4.1"
	},
	"prettier": {
		"printWidth": 100,
		"trailingComma": "es5",
		"singleQuote": true,
		"useTabs": true,
		"arrowParens": "always"
	},
	"dependencies": {
		"@mattlag/xmltojson": "^2.0.2",
		"bezier-boolean": "^1.0.6",
		"eslint": "^10.8.0",
		"esm-potrace-wasm": "0.5.1",
		"font-flux-js": "^2.9.0",
		"idb-keyval": "6.3.0",
		"svg-to-bezier": "^2.3.0"
	},
	"contributors": [
		"Brennan Meyer <brennanmmeyer@gmail.com>"
	]
}
