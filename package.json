{
	"name": "anyink",
	"author": "Matt LaGrandeur",
	"version": "2.10",
	"license": "GPL-3.0-or-later",
	"description": "ANY-INK: a personal, purely visual font editor. Fork of Glyphr Studio v2.",
	"type": "module",
	"scripts": {
		"dev": "run-func scripts.js dev && vite serve ./src/",
		"build": "run-func scripts.js build  && vite build ./src/ --emptyOutDir --base=/app/",
		"stage": "run-func scripts.js stage  && vite build ./src/ --emptyOutDir --base=/staged/",
		"test": "vitest watch",
		"coverage": "vitest watch --silent=true --coverage",
		"lint": "eslint src",
		"fix": "eslint src --fix",
		"pages": "vite --config tests/vite.config.js"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/jest": "^29.5.12",
		"@vitest/browser": "^4.1.11",
		"buffer": "^6.0.3",
		"eslint-config-prettier": "^8.5.0",
		"eslint-plugin-prettier": "^4.2.1",
		"globals": "^17.6.0",
		"jsdom": "^24.0.0",
		"lit": "^3.1.4",
		"prettier": "^2.7.1",
		"run-func": "^3.0.0",
		"typescript-eslint": "^8.61.1",
		"vi-canvas-mock": "^1.0.0",
		"vite": ">=7.3.2",
		"vitest": "^4.1.11"
	},
	"prettier": {
		"printWidth": 100,
		"trailingComma": "es5",
		"singleQuote": true,
		"useTabs": true,
		"arrowParens": "always"
	},
	"dependencies": {
		"@mattlag/xmltojson": "^2.0.2",
		"bezier-boolean": "^1.0.6",
		"eslint": "^10.8.0",
		"font-flux-js": "^2.9.0",
		"idb-keyval": "6.3.0",
		"svg-to-bezier": "^2.3.0"
	},
	"contributors": [
		"Brennan Meyer <brennanmmeyer@gmail.com>"
	]
}
